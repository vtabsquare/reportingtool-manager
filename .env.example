VTAB_MANAGER_HOST=127.0.0.1
VTAB_MANAGER_PORT=8840
VTAB_MANAGER_ENV=development
VTAB_MANAGER_API_KEY=replace-with-a-long-random-value
VTAB_MANAGER_DB=./data/vtab_manager.db
# Production Supabase/PostgreSQL source. Use the Session pooler on IPv4-only hosts.
# Keep sslmode=require. When set, this replaces the local SQLite source.
VTAB_MANAGER_DATABASE_URL=
VTAB_GITHUB_REPOSITORY=
# Optional for private repositories. Never expose this token in the browser.
VTAB_GITHUB_TOKEN=
GITHUB_REPOSITORY_SERVICES=https://github.com/your-org/vtab-reporting-services
GITHUB_REPOSITORY_ADMIN=https://github.com/your-org/vtab-admin-console
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
VTAB_GITHUB_ALLOWED_BRANCHES=main
VTAB_GITHUB_REQUIRED_CHECKS=build,test,security
# JSON object: API key -> actor and role. Roles: super_admin, release_manager,
# deployment_manager, operator, support, auditor.
VTAB_MANAGER_OPERATOR_KEYS_JSON={"replace-super-admin-key":{"actor":"platform-admin","role":"super_admin"}}
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The manager accepts this URL-safe base64 32-byte key for AES-GCM configuration encryption.
VTAB_CONFIG_ENCRYPTION_KEY=
VTAB_CONFIG_KEY_ID=manager-config-v1
VTAB_WEBHOOK_MAX_AGE_SECONDS=300
VTAB_DEPLOYMENT_LOCK_SECONDS=3600
VTAB_DEPLOYMENT_HEALTH_TIMEOUT_SECONDS=900
VTAB_UPDATE_POLL_INTERVAL_SECONDS=300
VTAB_MANAGER_OPEN_BROWSER=1

